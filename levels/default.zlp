; Vaults of Zor level pack, format 5 - edit with ZorEdit.exe or any text editor.
; [object] sections define the kinds of object; a level's map is # wall and . floor,
; and obj=X,Y,TYPE places an object (0,0 or 'nowhere' = not on the map yet,
; 'carried' = the player has it). The o... lines after it set that object's
; value, P1,P2, name, texts and own script. Scripts run until endscript.

[pack]
format=5
banner1=VAULTS
banner2=OF ZOR
subtitle=A MAZE ADVENTURE FOR THE TRS-80 MODEL I
line1=RECOVER THE AMULETS OF ZOR AND CLIMB BACK OUT
line2=ARROWS: UP=FORWARD  DOWN=BACK  LEFT/RIGHT=TURN
line3=OR TYPE COMMANDS: TAKE, OPEN, ATTACK, LOOK, HELP
victory=YOU CLIMB INTO THE SUNLIGHT WITH THE AMULETS OF ZOR!
starthp=12
maxhp=15
status=gold,$:
script=
# words the old engine knew
synonym UNLOCK = OPEN
synonym O = OPEN
synonym A = ATTACK
synonym KILL = ATTACK
synonym FIGHT = ATTACK
synonym HIT = ATTACK
synonym D = DRINK
synonym U = USE
endscript

[object]
id=ladder
name=A LADDER
look=ladder
nouns=LADDER
desc=THE LADDER UP TO DAYLIGHT.
script=
# the way out: climb it with the amulet
on arrive if has amulet then take amulet; score 100; say "YOU ESCAPE WITH THE AMULET!"; next; stop
on arrive then say "THE LADDER LEADS UP TO DAYLIGHT - BUT NOT WITHOUT THE AMULET!"
endscript

[object]
id=amulet
name=THE AMULET OF ZOR
look=amulet
flags=carry
nouns=AMULET
script=
on TAKE if here this then get this; say "YOU TAKE THE AMULET OF ZOR."; say "NOW BACK TO THE LADDER!"
endscript

[object]
id=door0
name=A DOOR
look=door
flags=solid
nouns=DOOR
desc=A STOUT IRON-BOUND DOOR. IT TAKES A BRASS KEY.
script=
on OPEN if ahead this and has key0 then take key0; remove this; say "THE KEY TURNS. THE DOOR GROANS OPEN."
on USE if ahead this and has key0 then take key0; remove this; say "THE KEY TURNS. THE DOOR GROANS OPEN."
on OPEN if ahead this then say "LOCKED. YOU NEED A BRASS KEY."
on bump then say "THE DOOR IS LOCKED."
endscript

[object]
id=key0
name=A BRASS KEY
look=key
flags=carry
nouns=KEY

[object]
id=gold
name=SOME GOLD
look=gold
nouns=GOLD,COINS
value=10
script=
# value = how many gold pieces (counted on the status line, and scored)
on TAKE if here this then add gold value; score value; say "YOU GATHER THE GOLD."; remove this
endscript

[object]
id=sword
name=A SHORT SWORD
look=sword
flags=carry,keep
nouns=SWORD

[object]
id=potion
name=A RED POTION
look=potion
flags=carry,keep
nouns=POTION
value=6
script=
# value = how many HP it heals
on DRINK if carried this then say "YOU FEEL STRONGER."; heal value; remove this
on USE if carried this then say "YOU FEEL STRONGER."; heal value; remove this
endscript

[object]
id=guardian
name=THE GUARDIAN
look=guardian
flags=solid
nouns=GUARDIAN,MONSTER
value=3
desc=THE HORNED GUARDIAN GLARES AT YOU AND SNORTS.
script=
# value = its hit points
on bump then say "THE GUARDIAN BARS THE WAY!"
on ATTACK if ahead this and has sword and chance 70 then value - 1; say "YOUR SWORD BITES DEEP!"
on ATTACK if ahead this and has sword then say "THE GUARDIAN DODGES."
on ATTACK if ahead this then say "YOUR FISTS DO NOTHING! YOU NEED A WEAPON."
every turn if value < 1 then remove this; say "THE GUARDIAN CRASHES DOWN, DEAD!"
every turn if near this and chance 37 then say "THE GUARDIAN GORES YOU!"; hurt 3 random
endscript

