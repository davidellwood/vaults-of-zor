[object]
id=fountain
name=A FOUNTAIN
look=fountain
nouns=FOUNTAIN,WATER
desc=A FOUNTAIN BUBBLES HERE.
script=
# value = drinks left (0 = never runs dry), P1 = HP healed (0 = fully), text 2 = message
on arrive if value >= 2 then say this 2; heal p1; value - 1; stop
on arrive if value >= 1 then say this 2; heal p1; remove this; say "THE FOUNTAIN RUNS DRY."; stop
on arrive then say this 2; heal p1
endscript

