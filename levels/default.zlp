obj=2,1,0,0,0,0,BEWARE: NOT EVERY STONE IS SOLID, NOT EVERY FLOOR IS SAFE.
obj=23,7,1,0,0,0,
obj=9,15,1,0,0,0,
obj=20,7,4,3,35,0,A HUGE GUARDIAN IN BLACK IRON ARMOUR BLOCKS THE PASSAGE.
obj=11,1,2,0,0,0,A HIDDEN SPIKE STABS YOUR FOOT!
obj=19,21,4,1,1,0,THE TRAP SNAPS SHUT, THEN CRUMBLES TO RUST.
obj=1,3,0,2,0,0,COOL WATER RESTORES YOU.
obj=13,21,29,21,0,0,
obj=4,5,18,2,0,0,
obj=14,9,0,0,0,0,YOU STEP THROUGH THE WALL - IT WAS ONLY AN ILLUSION!
obj=3,2,50,0,0,0,
obj=29,9,12,0,0,0,
obj=2,3,2,4,0,0,THE WATERS BEHIND ME WERE MINE ONCE... BUT YOU MAY DRINK. PASS, LIVING ONE, AND BEWARE THE HIDDEN SPIKES.

[level]
name=THE SAND PYRAMID
guardhp=3
facing=E
intro=BEYOND THE VAULTS A PYRAMID LIES HALF-BURIED IN THE SAND. THE TOMB OF PHARAOH NEB-SENU HOLDS THE LAST AMULET OF ZOR. THE DEAD DO NOT REST HERE.
map=
################################
################################
##############....##############
##############....##############
###############D################
###############.################
###############.################
###############.################
###############.################
###########@###.###&############
